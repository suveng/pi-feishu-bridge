{
  "name": "@suwenguang/pi-feishu-bridge",
  "version": "0.6.6",
  "description": "Feishu/Lark bridge for the Pi coding agent — chat with Pi from Feishu or Lark",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi",
    "feishu",
    "lark",
    "extension"
  ],
  "homepage": "https://github.com/suveng/pi-feishu-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suveng/pi-feishu-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/suveng/pi-feishu-bridge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2"
  },
  "exports": {
    "./pi": "./src/adapters/pi/index.ts"
  },
  "files": [
    "src",
    ".pi",
    "scripts"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/feishu/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./test/register.mjs --test test/*.test.mjs test/*.test.ts"
  }
}
